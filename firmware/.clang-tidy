---
Checks: >
  -*,
  performance-*,
  readability-*,
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  modernize-*,
  cert-*,
  misc-*,
  -misc-include-cleaner,
  -misc-header-include-cycle,

FormatStyle: none
WarningsAsErrors: '*'
CheckOptions:
  - key: bugprone-argument-comment.StrictMode
    value: true
  - key: bugprone-branch-clone.SuppressDirectives
    value: true
  - key: readability-magic-numbers.IgnorePowersOf2IntegerValues
    value: true