# ==================== Build the VSLAM workspace ==============================
RUN mkdir -p /ros2_ws/src
WORKDIR /ros2_ws

RUN set -x && cd src && \
  git clone -b main-arm64 --recursive https://github.com/kuralme/stella_vslam_ros.git
# RUN cd src/stella_vslam_ros && \
#   sed -i '/if(NOT WIN32)/,/endif()/d' CMakeLists.txt &&\
#   sed -i '/include_directories(${EIGEN3_INCLUDE_DIR})/a include_directories(${cv_bridge_INCLUDE_DIRS})' CMakeLists.txt &&\
#   sed -i 's/target_link_libraries(${EXECUTABLE_TARGET}/target_link_libraries(${EXECUTABLE_TARGET} PRIVATE cv_bridge::cv_bridge/g' src/CMakeLists.txt

RUN set -x && \
  : "build ROS2 packages" && \
  bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash; \
  colcon build --parallel-workers ${NUM_THREADS} --cmake-args \
    -DUSE_STACK_TRACE_LOGGER=ON"

COPY docker/ros_entrypoint.sh /
COPY docker/fastdds_profile.xml /

RUN chmod +x /ros_entrypoint.sh
ENTRYPOINT [ "/ros_entrypoint.sh" ]